# 只用这个选择当前运行模式：nat 或 proxyarp
# 两套模式配置可以同时写在本文件里，实际只会使用 VPN_MODE 选中的那一套。
# 修改本文件对应的 .env 后，docker compose restart 即可生效（需先升级到支持运行时配置的镜像及 Compose 文件）。
# 使用 KEY=VALUE，可加单/双引号和行尾注释；值按字面读取，不做 ${变量} 或命令替换。
VPN_MODE=nat

# VPN 服务器域名，必须和证书 SAN / 客户端 IPSec 标识符一致。
VPN_DOMAIN=vpn.example.com

# 证书文件名，文件必须放在 ssl/ 目录中。
# 使用其他域名或证书时，只修改这两个文件名，不需要改脚本。
VPN_CERT_FILE=server.crt
VPN_KEY_FILE=server.key

# VPN 账号不写在 .env 里。
# 请编辑默认提供的 config/users.txt，格式为：用户名:密码

# =========================
# NAT 模式配置
# =========================
# NAT 模式：VPN 客户端使用独立网段，通过 MASQUERADE/NAT 访问内网和外网。
NAT_VPN_POOL=10.66.0.0/24
NAT_DNS1=1.1.1.1
NAT_DNS2=8.8.8.8
# NAT_LOCAL_TS 默认 0.0.0.0/0，表示客户端默认走全局隧道。
# NAT_LOCAL_TS=0.0.0.0/0

# =========================
# Proxy ARP 同网段模式配置
# =========================
# Proxy ARP 模式：VPN 客户端使用局域网同网段地址，不做 NAT。
# PROXYARP_VPN_POOL 只能从以下两种格式中选一种：
#   1. CIDR 网段：192.168.0.240/28
#   2. 连续 IP 范围：192.168.0.200-192.168.0.210
# 不要填多个网段、逗号列表或带空格的值。
# 所有地址必须属于局域网网段，并从路由器 DHCP 地址池中排除，不能和已有设备冲突。
PROXYARP_VPN_POOL=192.168.0.240/28

# 下发给 VPN 客户端的 DNS。
# 如果不填 PROXYARP_DNS1，脚本会从 PROXYARP_VPN_POOL 自动推导，例如 192.168.0.240/28 -> 192.168.0.1。
# 如果你的网关/DNS 不是 .1，请手动填写。
# PROXYARP_DNS1=192.168.0.1
# PROXYARP_DNS2=1.1.1.1

# 高级可选，一般不用填。
# PROXYARP_LAN_SUBNET = 服务端知道你的家里内网范围，给服务端防火墙和 Proxy ARP 判断用。
# 例如家里路由器是 192.168.0.1，FnNas 是 192.168.0.2，那家里内网范围通常就是 192.168.0.0/24。
# 默认会从 PROXYARP_VPN_POOL 自动推导：
#   192.168.0.240/28 -> 192.168.0.0/24
#   192.168.0.180-192.168.0.200 -> 192.168.0.0/24
# 只有你的局域网不是 /24，或者自动推导不对，才需要取消注释手动写。
# PROXYARP_LAN_SUBNET=192.168.0.0/24

# 高级可选，一般不用填。
# PROXYARP_LOCAL_TS = 告诉客户端哪些目标地址走 VPN。
# 默认等于 PROXYARP_LAN_SUBNET，也就是只让访问家里内网的流量走 VPN。
# 例如默认是 192.168.0.0/24，表示客户端访问 192.168.0.x 走 VPN，访问公网不走 VPN。
# 如果想让客户端所有 IPv4 流量都走 VPN，才改成 0.0.0.0/0。
# PROXYARP_LOCAL_TS=192.168.0.0/24

# 可选：已进入 VPN 的非 LAN IPv4 流量交给同局域网的路由设备。
# 留空时继续使用宿主机原有路由；不修改宿主机默认网关。
# 网关必须在 LAN 内、地址池外，不能填写宿主机自身地址。
# 旁路由必须支持转发、上网 NAT 和回程；DNS 仍由 PROXYARP_DNS1/2 单独指定。
# 公网上网还需设置 PROXYARP_LOCAL_TS=0.0.0.0/0，并在客户端启用全隧道。
# PROXYARP_GATEWAY=192.168.0.3
